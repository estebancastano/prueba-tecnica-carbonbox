{
  "name": "carbonbox-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/index.js",
    "db:generate": "prisma generate --schema src/document-processing/infrastructure/persistence/models/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/document-processing/infrastructure/persistence/models/schema.prisma --name update",
    "db:deploy": "prisma migrate deploy --schema src/document-processing/infrastructure/persistence/models/schema.prisma"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "convict": "^6.2.4",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
